# Copy this file to .env and fill in the required values.
# Precedence: real environment variables > .env > defaults in src/cmdb/config.py.

# Required: OpenRouter API key (https://openrouter.ai/keys). Needed for AI features.
OPENROUTER_API_KEY=

# Optional overrides. Defaults live in src/cmdb/config.py; uncomment a line to change it.
# OPENROUTER_MODEL=anthropic/claude-haiku-4.5
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# LLM_TIMEOUT_SECONDS=60
# LLM_STRUCTURED_OUTPUTS=true
# DATABASE_URL=sqlite:///data/cmdb.db
# MAX_UPLOAD_BYTES=10485760
# ENTITY_MATCH_AUTO_MERGE_THRESHOLD=0.8
# ASK_MAX_ROWS=200
# ASK_TIMEOUT_SECONDS=5
# HOST=127.0.0.1
# PORT=8000
# LOG_LEVEL=info
