# Copy this file to .env and fill in your values.

# OpenRouter API key (https://openrouter.ai/keys). Required for AI features.
OPENROUTER_API_KEY=

# Any model ID available on OpenRouter.
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# SQLAlchemy database URL. The SQLite file is created automatically.
DATABASE_URL=sqlite:///data/cmdb.db
